# Public URL of the site (no trailing slash). Used for canonical URLs, sitemap, Open Graph and WhatsApp links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (https://resend.com): API key used by /api/enquiry to send emails.
RESEND_API_KEY=

# Where enquiries are delivered.
ENQUIRY_TO_EMAIL=contact@monolithproperties.ae

# Sender shown on enquiry emails. Must be a verified domain in Resend.
# For local testing you can use: Monolith Properties <onboarding@resend.dev>
ENQUIRY_FROM_EMAIL="Monolith Properties <onboarding@resend.dev>"

# Optional: Google Analytics 4 measurement ID (for example G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=
